# Sending backend: manual (default), droid (v1, not yet verified live), or google
SENDER_BACKEND=manual
# Base for panel links in emails. Change this when the app is hosted.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Hours before an open F2F is purged from memory
SESSION_TTL_HOURS=12
# Optional fixed admin passcode (otherwise a random one is printed at startup)
# ADMIN_PASSCODE=

# droid backend
DROID_BIN=droid
# low is refused for connector sends; see README
DROID_AUTO=medium
# DROID_MODEL=

# GenAI Platform (LiteLLM, OpenAI-compatible). Without a key the app uses rubric text.
# GENAI_PLATFORM_API_KEY=
GENAI_BASE_URL=https://genai-platform.is.adyen.com/v1
GENAI_MODEL=gemma4-31b

# google backend (needs an Internal OAuth client approved by IT and HTTPS)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TL_ALLOWED_EMAILS=tl.one@adyen.com,tl.two@adyen.com
# SECURE_COOKIES=true
